include LICENSE README.md THIRD_PARTY.md deployment.example.json .gitignore
include requirements*.txt requirements.lock runtime-overrides.txt
recursive-include licenses *.txt
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py
recursive-include runtimes *.py *.c *.sh *.json *.md
recursive-include third_party *.py *.txt *.md *.toml *.sh LICENSE NOTICE py.typed
prune build
prune dist
global-exclude __pycache__ *.py[cod] .DS_Store
